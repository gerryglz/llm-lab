{
  "name": "llm-lab",
  "version": "1.0.0",
  "description": "A local, source-grounded Dice Throne rules assistant built with LM Studio.",
  "main": "index.js",
  "scripts": {
    "check": "tsc --noEmit",
    "build": "tsc --rootDir src --outDir dist",
    "start": "node dist/index.js",
    "serve": "node dist/server.js",
    "eval:normal": "node dist/eval.js",
    "eval:hard": "node dist/eval-hard.js",
    "eval:blind": "node dist/eval-blind.js",
    "eval:answers": "node dist/eval-answer.js",
    "eval:evidence": "node dist/eval-evidence.js",
    "eval:conversation": "node dist/eval-conversation.js",
    "eval:assumptions": "node dist/eval-assumptions.js",
    "eval:completeness": "node dist/eval-completeness.js",
    "eval:planner": "node dist/eval-planner.js",
    "eval:http": "node dist/eval-http.js",
    "eval:source": "node dist/eval-source.js",
    "eval:advanced": "node dist/eval-advanced.js",
    "ingest:core": "node dist/ingest.js",
    "ingest:advanced": "node dist/ingest-advanced.js",
    "index": "node dist/build-index.js"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "dependencies": {
    "openai": "^7.5.0",
    "pdf-parse": "^2.4.5",
    "typescript": "^7.0.2"
  },
  "devDependencies": {
    "@types/node": "^26.2.0"
  }
}

